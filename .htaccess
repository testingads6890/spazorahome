# Put this file in the project ROOT folder (next to app/, public/, .env) and rename it to .htaccess.
# Only the public/ folder is ever served. .env, storage/logs, database/, deploy/ etc. can no longer be
# downloaded from the browser, and the site works both at /... and at /public/...
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>